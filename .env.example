# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Option A: local Ollama (fully offline, free)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Option B: Groq free tier (fastest -> easiest way to hit 2-5 s). Get a key at console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxx
# LLM_MODEL=llama-3.1-8b-instant      # check Groq's model list; names change over time

# ---------- Embeddings / retrieval (defaults shown) ----------
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# USE_RERANK=true
# TOP_K=20
# TOP_N=5
# CHUNK_TOKENS=480
# OVERLAP_RATIO=0.15
# OCR_LANG=eng            # e.g. eng+hin
