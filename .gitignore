data/pdfs/*
!data/pdfs/.gitkeep

data/processed/*
!data/processed/.gitkeep
!data/processed/pages/
!data/processed/chunks/

data/processed/pages/*
!data/processed/pages/.gitkeep

data/processed/chunks/*
!data/processed/chunks/.gitkeep

# Evaluation outputs
.cache/